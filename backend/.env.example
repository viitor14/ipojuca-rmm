PORT=4000
NODE_ENV=development
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173

# Segredos de Autenticacao e Assinatura (Obrigatorio gerar fortes em producao: openssl rand -hex 32)
JWT_SECRET=rmm-ipojuca-jwt-secret-change-in-production-2026
TASK_SIGNING_SECRET=rmm-ipojuca-hmac-task-secret-change-in-production-2026
N8N_WEBHOOK_SECRET=rmm-ipojuca-n8n-webhook-secret-2026
AGENT_ENROLLMENT_KEY=rmm-ipojuca-enroll-2026

# Senhas de seed inicial (em producao, definir apenas no primeiro boot ou gerenciar via banco)
SEED_ADMIN_PASSWORD=
SEED_TECH_PASSWORD=
SEED_VIEWER_PASSWORD=

# Banco de Dados MySQL
DB_MODE=auto
DB_HOST=mysql
DB_PORT=3306
DB_USER=rmm_user
DB_PASSWORD=rmm_pass_change_me
DB_NAME=ipojuca_rmm

# Limite para considerar computador OFFLINE (segundos: 15000s = 4h10min para ciclo 4h)
OFFLINE_THRESHOLD_SECONDS=15000
# Limite para gerar alerta automatico de inatividade (segundos: 86400s = 24h)
INACTIVITY_ALERT_SECONDS=86400

# Integracao n8n (Inovacao B)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/rmm-alert
DASHBOARD_PUBLIC_URL=http://localhost:5173
